# Local development only. Configure production variables in the Render dashboard.
# Never commit a real .env file or any real credentials.
APP_ENV=development
DATABASE_URL=
APP_USERNAME=
# APP_PASSWORD_HASH must be a password hash, never a plaintext password.
APP_PASSWORD_HASH=
SESSION_SECRET=

# Optional session lifetime in seconds.
SESSION_MAX_AGE=604800

# AI_PROVIDER may be "mock" or "gemini". GEMINI_API_KEY is required for Gemini.
AI_PROVIDER=mock
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
# Ask My Notes AI call timeout in seconds.
ASSISTANT_AI_TIMEOUT_SECONDS=15
